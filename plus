cd ~/robosys2026

# mainブランチにいることを確認（devにいる場合は git switch main）
git switch main

# 冒頭にSPDXタグを追加したコードで上書き
cat << 'EOF' > plus_stdin
#!/usr/bin/python3
# SPDX-FileCopyrightText: 2026 Kento Someya
# SPDX-License-Identifier: BSD-3-Clause
import sys

def tonum(s):
    try:
        return int(s)
    except ValueError:
        return float(s)

x = 0
for line in sys.stdin:
    x += tonum(line.rstrip())

print(x)
EOF

# 実行権限を保持
chmod +x plus_stdin

