cd ~/robosys2026
git switch main

# plus のシバンを #!/usr/bin/env python3 に変更して更新
cat << 'EOF' > plus
#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Kento Someya
# SPDX-License-Identifier: BSD-3-Clause
import sys

def tonum(s):
    try:
        return int(s)
    except ValueError:
        return float(s)

x = 0
for line in sys.stdin:
    x += tonum(line.rstrip())

print(x)
EOF

chmod +x plus

